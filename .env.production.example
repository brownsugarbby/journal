# Production settings for H D's server. Copy to .env, fill every value marked
# CHANGE, then follow docs/DEPLOY.md. Never commit the real .env.

APP_NAME="Journal System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: the real address, with https
APP_URL=https://journal.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Behind Cloudflare / a load balancer: TRUSTED_PROXIES=*  (empty when Nginx faces the internet)
TRUSTED_PROXIES=

# First superadmin, used once by `php artisan db:seed --force`.
# CHANGE: username and a long password; remove the password from this file after the first login.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# CHANGE: MySQL 8.4 database and a user that only has rights on it
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=journal
DB_USERNAME=journal
DB_PASSWORD=

SESSION_DRIVER=database
# Staff are logged out after 8 hours idle.
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Backups (docs/DEPLOY.md §6). CHANGE: a long archive password, stored somewhere
# safe outside the server: without it the backups cannot be opened.
BACKUP_DISKS=backups
BACKUP_PATH=/var/backups/journal-system
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=

# Mail, for backup failure alerts. CHANGE to a real SMTP account.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
