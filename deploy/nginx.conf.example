# /etc/nginx/sites-available/journal
#
# HTTP only on purpose: works on every Nginx version. Then run
#   certbot --nginx -d journal.example.com
# and choose "redirect": certbot adds the HTTPS server, the certificate and
# the HTTP → HTTPS redirect to this file (docs/DEPLOY.md §5).
#
# Replace journal.example.com with the real domain and /var/www/journal with
# the folder the app was cloned into.

server {
    listen 80;
    listen [::]:80;
    server_name journal.example.com;

    root /var/www/journal/public;
    index index.php;
    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Logo / receipt uploads.
    client_max_body_size 10M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120;
    }

    # Nothing else in public/ is PHP; dotfiles are never served.
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
